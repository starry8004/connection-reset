{
  "manifest_version": 3,
  "name": "접속 리셋 · Connection Reset",
  "version": "1.0.1",
  "description": "현재 사이트 데이터 삭제와 브라우저·핫스팟·유선 연결·Windows IP 갱신 안내를 한곳에서 실행하세요.",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "browsingData", "clipboardWrite", "storage"],
  "action": {
    "default_title": "접속 리셋 열기",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js", "type": "module"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
